
# ==========================================
# Application
# ==========================================
SPRING_APPLICATION_NAME=OrbitLogisticApp
SERVER_PORT=8000

# ==========================================
# PostgreSQL
# ==========================================
DB_URL=jdbc:postgresql://localhost:5432/OrbitDB
DB_USERNAME=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD

# ==========================================
# JWT
# ==========================================
JWT_SECRET=willBeHidedInProductionThisIsJustADemoJwtSecretKey2000000000

# ==========================================
# SMTP Configuration (Gmail)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ==========================================
# Frontend
# ==========================================
FRONTEND_BASE_URL=http://localhost:3000

# ==========================================
# MCP Server
# ==========================================
MCP_SERVER_NAME=orbit-vmi
MCP_SERVER_VERSION=1.0.0

# ==========================================
# MCP Client
# ==========================================
MCP_CLIENT_NAME=orbit-chat-client
MCP_SERVER_URL=http://localhost:8000
MCP_SERVER_ENDPOINT=/mcp

# ==========================================
# OpenAI
# ==========================================
SPRING_AI_OPENAI_API_KEY=YOUR_API_KEY
SPRING_AI_OPENAI_BASE_URL=
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gpt-5.4-mini
